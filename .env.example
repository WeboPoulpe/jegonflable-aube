# ============================================
# JEGONFLABLE AUBE — Variables d'environnement
# ============================================
# Copie ce fichier en .env.local et remplis les valeurs

# --- Base de données (Neon PostgreSQL) ---
# 1. Crée un compte gratuit sur https://neon.tech
# 2. Crée un projet "jegonflable-aube"
# 3. Copie la "Connection string" depuis le dashboard
# 4. Colle-la ici (remplace bien le mot de passe)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/jegonflable?sslmode=require"

# --- NextAuth ---
# Génère un secret aléatoire avec : openssl rand -base64 32
NEXTAUTH_SECRET="change-moi-en-production"
NEXTAUTH_URL="http://localhost:3000"

# --- Email (Brevo SMTP) ---
# 1. Crée un compte gratuit sur https://www.brevo.com
# 2. Va dans SMTP & API > SMTP > génère une clé
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="ton-login@smtp-brevo.com"
BREVO_SMTP_PASSWORD="ta-cle-smtp"
EMAIL_FROM="contact@jegonflable-aube.fr"
ADMIN_EMAIL="contact@jegonflable-aube.fr"

# --- Stripe (optionnel — activable en Phase 7) ---
STRIPE_ENABLED="false"
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"

# --- Onboarding (côté Max uniquement) ---
# Mets "true" pour skip l'onboarding chasse au trésor (utile pour tester)
SKIP_ONBOARDING="false"

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Jegonflable Aube"
